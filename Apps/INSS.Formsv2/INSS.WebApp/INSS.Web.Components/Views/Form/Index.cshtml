@{
    ViewData["Title"] = "Bank Account Details";
}

@addTagHelper GovUk.Frontend.AspNetCore.TagHelpers.*, GovUk.Frontend.AspNetCore
@addTagHelper INSS.Web.Components.TagHelpers.*, INSS.Web.Components

@using INSS.Web.Components.Extensions
@model INSS.Web.Components.Models.FormModel

<inss-task-list>
    @foreach(var section in Model.Sections)
    {
        <inss-task-list-item name="@(section.Name)" is-complete="@(section.IsComplete)" url="@(section.GetPageUrl(Model, section.Pages.First()))" />
    }
    @Url.OurUrl(Model)
</inss-task-list>