<div id="@divId" style="display: @displayStyle">
    @ChildContent
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool IsVisible { get; set; } = true;

    private string divId => $"formPage_{Guid.NewGuid().ToString()}";
    private string displayStyle => IsVisible ? "block;" : "none;";
}
