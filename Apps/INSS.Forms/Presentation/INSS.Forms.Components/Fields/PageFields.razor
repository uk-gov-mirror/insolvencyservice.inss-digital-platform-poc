
<div style="@displayStyle" id="@GenerateElementId()">
    @ChildContent
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool IsVisible { get; set; } = true;

    private string displayStyle => IsVisible ? string.Empty : "display: none;";

    private string GenerateElementId()
    {
        return $"inss-form-element-id-form-page-{Guid.NewGuid().ToString("N")}";
    }
}
