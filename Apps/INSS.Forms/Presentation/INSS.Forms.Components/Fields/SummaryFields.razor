<dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
            Name
        </dt>
        <dd class="govuk-summary-list__value">
            @AboutYouSummary?.Name
        </dd>
        <dd class="govuk-summary-list__actions">
            <a class="govuk-link" href="#">Change<span class="govuk-visually-hidden"> name</span></a>
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
            Date of birth
        </dt>
        <dd class="govuk-summary-list__value">
            @AboutYouSummary?.DateOfBirth
        </dd>
        <dd class="govuk-summary-list__actions">
            <a class="govuk-link" href="#">Change<span class="govuk-visually-hidden"> date of birth</span></a>
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
            Address
        </dt>
        <dd class="govuk-summary-list__value">
            @AboutYouSummary?.Address.Address1<br />
            @AboutYouSummary?.Address.Address2<br /> 
            @AboutYouSummary?.Address.Town<br />
            @AboutYouSummary?.Address.Postcode<br />
