        </dd>
        <dd class="govuk-summary-list__actions">
            <a class="govuk-link" href="#">Change<span class="govuk-visually-hidden"> Telephone</span></a>
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
            Email
        </dt>
        <dd class="govuk-summary-list__value">
            @AboutYouSummary?.Email
        </dd>
        <dd class="govuk-summary-list__actions">
            <a class="govuk-link" href="#">Change<span class="govuk-visually-hidden"> Email</span></a>
        </dd>
    </div>
</dl>

@code {
    [Parameter]
    public AboutYou? AboutYouSummary { get; set; }
}

