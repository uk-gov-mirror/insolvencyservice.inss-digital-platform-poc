@inherits RequiredAttributeBase

<fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
        <h1 class="govuk-fieldset__heading">
            @Text
        </h1>
    </legend>

    <GdsTextInputField text="Address line 1" Name="address1" @bind-Value="Value.Address1" />

    <GdsTextInputField text="Address line 2" Name="address2" @bind-Value="Value.Address2" />

    <GdsTextInputField text="Town" Name="town" @bind-Value="Value.Town" />

    <GdsTextInputField text="Postcode" Name="postcode" @bind-Value="Value.Postcode" />
</fieldset>


@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public Address Value { get; set; } = new Address();

    [Parameter]
    public EventCallback<Address> ValueChanged { get; set; }
}

