@inherits InssComponentBase

<a href="#" class="govuk-back-link" @onclick="OnClick" id="@GenerateElementId()" style="@displayStyle">Back</a>


@code {

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter]
    public bool IsVisible { get; set; } = true;

    private string displayStyle => IsVisible ? string.Empty : "display: none;";
}
