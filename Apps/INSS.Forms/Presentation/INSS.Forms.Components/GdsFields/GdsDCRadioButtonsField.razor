@inherits RequiredAttributeBase

<div class="govuk-form-group" id="@GenerateElementId("radio-group")">
    <fieldset class="govuk-fieldset" aria-describedby="@GenerateElementId("radio-group-hint")">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
            <InputTextHeading Name="heading-radios">
                @Text
            </InputTextHeading>
        </legend>
        <div id="@GenerateElementId("radio-group-hint")" class="govuk-hint">
            @Hint
        </div>
        <div class="govuk-radios @(Inline ? "govuk-radios--inline" : "")" data-module="govuk-radios">
            @foreach(var item in Items)
            {
                <div class="govuk-radios__item">
                    <input class="govuk-radios__input"
                           id="@GenerateElementId(item.Value)"
                           name="@GenerateElementName(item.Value)"
                           type="radio"
                           value="@item.Value"
                           checked="@(Value == item.Value)"
                           @onchange="() => OnRadioChanged(item.Value)" 
                    />
                    <label class="govuk-label govuk-radios__label" for="@GenerateElementId(item.Value)">
                        @item.Text
                    </label>
                </div>
            }
        </div>
    </fieldset>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public List<RadioOption<string>> Items { get; set; }

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string Hint { get; set; } = string.Empty;

    [Parameter]
    public bool Inline { get; set; } = false;

    [Parameter]
    public string Value { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    private async Task OnRadioChanged(string newValue)
    {
        Value = newValue;
        await ValueChanged.InvokeAsync(newValue);
    }
}
