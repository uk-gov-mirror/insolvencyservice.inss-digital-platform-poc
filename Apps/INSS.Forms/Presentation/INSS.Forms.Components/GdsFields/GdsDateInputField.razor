@inherits RequiredAttributeBase

<div class="govuk-form-group">
    <fieldset class="govuk-fieldset" role="group" aria-describedby="passport-issued-hint">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
            <h1 class="govuk-fieldset__heading">
                @Text
            </h1>
        </legend>
        <div id="@hintId" class="govuk-hint">
            @Hint
        </div>
        <div class="govuk-date-input" id="@GenerateElementId()">
            <div class="govuk-date-input__item">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-date-input__label" for="@dayInputId">
                        Day
                    </label>
                    <input 
                    class="govuk-input govuk-date-input__input govuk-input--width-2" 
                    id="@dayInputId" 
                    name="@dayInputName" 
                    type="text" 
                    inputmode="numeric" 
                    title="Day"
                    placeholder=""
                    @bind="Day"
                    min="1"
                    max="31"
                    />
                </div>
            </div>
            <div class="govuk-date-input__item">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-date-input__label" for="@monthInputId">
                        Month
                    </label>
                    <input 
                    class="govuk-input govuk-date-input__input govuk-input--width-2" 
                    id="@monthInputId" 
                    name="@monthInputName" 
                    type="text" 
                    inputmode="numeric" 
                    placeholder=""
                    title="Month"
                    @bind="Month"
                    min="1"
                    max="12"
                    />
                </div>
            </div>
            <div class="govuk-date-input__item">
                <div class="govuk-form-group">
                    <label class="govuk-label govuk-date-input__label" for="@yearInputId">
                        Year
                    </label>
                    <input 
                    class="govuk-input govuk-date-input__input govuk-input--width-4" 
                    id="@yearInputId" 
                    name="@yearInputName" 
                    type="text" 
                    inputmode="numeric" 
                    title="Year"
                    placeholder=""
                    @bind="Year"
                    min="1900"
                    max="@DateTime.Now.Year"/>
                </div>
            </div>
        </div>
    </fieldset>
</div>

@code {

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string Hint { get; set; } = string.Empty;

    [Parameter]
    public DateTime? Value { get; set; }

    [Parameter]
    public EventCallback<DateTime?> ValueChanged { get; set; }

    private string? _elementId;
    private string elementId => _elementId ??= GenerateElementId();

    private string dayInputId => $"{elementId}-day";
    private string monthInputId => $"{elementId}-month";
    private string yearInputId => $"{elementId}-year";
    private string dayInputName => $"{GenerateElementName()}-day";
    private string monthInputName => $"{GenerateElementName()}-month";
    private string yearInputName => $"{GenerateElementName()}-year";
    private string hintId => $"{GenerateElementName()}-hint";

    private async Task TryUpdateValue()
    {
        if (Day.HasValue && Month.HasValue && Year.HasValue
        && DateTime.TryParse($"{Year}-{Month}-{Day}", out var newDate))
        {
            Value = newDate;
            await ValueChanged.InvokeAsync(Value);
        }
        else
        {
            Value = null;
            await ValueChanged.InvokeAsync(null);
        }
    }

    private int? _day;
    private int? _month;    
    private int? _year;

    private int? Day
    {
        get => _day;
        set
        {
            _day = value;
            Task.Run(() => TryUpdateValue());
        }
    }

    private int? Month
    {
        get => _month;
        set
        {
            _month = value;
            Task.Run(() => TryUpdateValue());
        }
    }   

    private int? Year
    {
        get => _year;
        set
        {
            _year = value;
            Task.Run(() => TryUpdateValue());
        }
    }

    protected override void OnParametersSet()
    {
        if(Value.HasValue)
        {
            Day = Value.Value.Day;
            Month = Value.Value.Month;
            Year = Value.Value.Year;
        }else
        {
            Day = null;
            Month = null;
            Year = null;
        }
    }

}
