@inherits RequiredAttributeBase
<button type="submit" class="govuk-button" data-module="govuk-button" id="@GenerateElementId()" name="@GenerateElementName()" title="@ChildContent" @onclick="OnClick">
    @ChildContent
</button>

@code {

    [Parameter]
    public RenderFragment ChildContent { get; set; } = builder => builder.AddContent(0, "Submit");

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }
}
