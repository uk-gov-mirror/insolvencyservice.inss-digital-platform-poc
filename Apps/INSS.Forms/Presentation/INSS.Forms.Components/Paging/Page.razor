@inherits InssComponentBase
@inject IFormPageNavigatorService FormPageNavigationService

<div style="@displayStyle" id="@GenerateElementId("page")">
    @ChildContent
</div>

@code {

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public bool Hide { get; set; }

    private string displayStyle = "display: none;";

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(Name))
        {
            if (!FormPageNavigationService.PageNames.Contains(Name))
            {
                FormPageNavigationService.PageNames.Add(Name);
            }

        }

        displayStyle = FormPageNavigationService.PageVisibility(Name, Hide) && !Hide ? string.Empty : "display: none;";

        base.OnParametersSet();
    }
}
