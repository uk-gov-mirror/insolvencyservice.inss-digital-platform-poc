@inherits SummaryBase<CompanyDetails>

<dl class="govuk-summary-list">

    <SummaryRow Name="name" Text="Company Name" Values="@GetValue(FormData?.CompanyName)" OnClick='() => OnNext.InvokeAsync("companyname-page")' />

    <SummaryRow Name="type" Text="Company Type" Values="@GetValue(FormData?.CompanyType?.GetDescription())" OnClick='() => OnNext.InvokeAsync("companytype-page")' />

    <SummaryRow Name="companyref" IsVisible="@IsVisible(IsCompanyRefVisible)" Text="Companies House Ref" Values="@GetValue(FormData?.CompaniesHouseReferenceNumber)" OnClick='() => OnNext.InvokeAsync("companieshousereferencenumber-page")' />

    <SummaryRow Name="charityref" IsVisible="@IsVisible(IsCompanyCharityRefVisible)" Text="Charity Ref" Values="@GetValue(FormData?.CharityReferenceNumber)" OnClick='() => OnNext.InvokeAsync("charitynumber-page")' />

    <SummaryRow 
    Name="address" 
    Text="Address"
    Values="@(new[] {
            FormData?.CompanyAddress?.Address1 ?? string.Empty,
            FormData?.CompanyAddress?.Address2 ?? string.Empty,
            FormData?.CompanyAddress?.Town ?? string.Empty,
            FormData?.CompanyAddress?.Postcode ?? string.Empty
        })"
    OnClick='() => OnNext.InvokeAsync("companyaddress-page")' 
    />

    <SummaryRow Name="telephone" Text="Telephone" Values="@GetValue(FormData?.CompanyTelephone)" OnClick='() => OnNext.InvokeAsync("companytelephone-page")' />

</dl>

@code {
    private bool IsCompanyRefVisible()
    {
        return FormData?.CompanyType == CompanyType.LimitedCompany;
    }

    private bool IsCompanyCharityRefVisible()
    {
        return FormData?.CompanyType == CompanyType.RegisteredCharity;
    }
}