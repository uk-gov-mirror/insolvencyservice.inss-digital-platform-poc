@rendermode RenderMode.InteractiveServer
@page "/company-details"
@inherits FormPagerBase

<PageTitle>Company Details</PageTitle>

<HeadingText Name="heading-company-details">Company Details</HeadingText>

<GdsBackField Name="back-btn" IsVisible="@(!IsFirstPage )" OnClick="@Back" />

<PageFields IsVisible="@PageVisibility("companyname-page")">
    <GdsTextInputField Text="What is your company name?" Name="company-name" @bind-Value="companyDetailsForm.CompanyName" />
</PageFields>

<PageFields IsVisible="@PageVisibility("companytype-page")">
    <GdsRadioButtonsField Name="company-type"
    Text="What is your company type?"
    Items="@companyTypeOptions"
    Value="@companyDetailsForm.CompanyType.ToString()"
    ValueChanged="@(v => UpdateCompanyType(v))" />
</PageFields>

<PageFields IsVisible="@PageVisibility("companieshousereferencenumber-page", ShouldCompaniesHouseReferenceNumberBeHidden)">
    <GdsTextInputField text="What is your companies house reference number?" Name="company-companyref" @bind-Value="companyDetailsForm.CompaniesHouseReferenceNumber" />
</PageFields>

<PageFields IsVisible="@PageVisibility("charitynumber-page", ShouldCharityNumberBeHidden)">
    <GdsTextInputField text="What is your registered charity number?" Name="company-charityref" @bind-Value="companyDetailsForm.CharityReferenceNumber" />
</PageFields>

<PageFields IsVisible="@PageVisibility("companyaddress-page")">
    <AddressFields Text="What is your company address?" Name="company-address" @bind-Value="companyDetailsForm.CompanyAddress" />
</PageFields>

<PageFields IsVisible="@PageVisibility("companytelephone-page")">
    <GdsTextInputField Text="What is your telephone number?" Name="company-telephone" @bind-Value="companyDetailsForm.CompanyTelephone" />
</PageFields>

<PageFields IsVisible="@PageVisibility("summary-page")">
    <CompanyDetailsSummary FormData="@companyDetailsForm" OnNext="@(page => Next(page))" />
</PageFields>

<GdsButtonField Name="next-btn" OnClick="@Next">
    @(IsLastPage ? "Apply" : "Next")
</GdsButtonField>

@code {
    private CompanyDetails companyDetailsForm = new CompanyDetails();

    private List<RadioOption<string>> companyTypeOptions = EnumHelper.ToRadioOptions<CompanyType>();

    protected override void OnInitialized()
    {
        PageNames = new string[]
        {
            "companyname-page",
            "companytype-page",
            "companieshousereferencenumber-page",
            "charitynumber-page",
            "companyaddress-page",
            "companytelephone-page",
            "summary-page"
        };
    }

    private bool ShouldCompaniesHouseReferenceNumberBeHidden()
    {
        return companyDetailsForm.CompanyType != CompanyType.LimitedCompany;
    }

    private bool ShouldCharityNumberBeHidden()
    {
        return companyDetailsForm.CompanyType != CompanyType.RegisteredCharity;
    }

    private void UpdateCompanyType(string value)
    {
        companyDetailsForm.CompanyType = Enum.Parse<CompanyType>(value);

        companyDetailsForm.CompaniesHouseReferenceNumber = string.Empty;
        companyDetailsForm.CharityReferenceNumber = string.Empty;
    }
}

