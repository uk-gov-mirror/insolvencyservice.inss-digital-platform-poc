@page "/about-you"
@inherits FormPagerBase

<PageTitle>About You</PageTitle>

<HeadingText Name="heading-about-you">About You</HeadingText>

<GdsBackField Name="back-btn" IsVisible="@(!IsFirstPage)" OnClick="@Back" />

<PageFields IsVisible="@PageVisibility("name-page")">
    <GdsTextInputField Text="What is your name?" Name="person-name" @bind-Value="aboutYouForm.Name" />
</PageFields>

<PageFields IsVisible="@PageVisibility("dob-page")">
    <GdsDateInputField text="What is your date of birth?" Name="person-dob" Hint="For example, 27 3 2007" @bind-Value="aboutYouForm.DateOfBirth"/>
</PageFields>

<PageFields IsVisible="@PageVisibility("address-page")">
    <AddressFields Text="What is your address?" Name="person-address" @bind-Value="aboutYouForm.Address" />
</PageFields>

<PageFields IsVisible="@PageVisibility("telephone-page")">
    <GdsTextInputField Text="What is your telephone number?" Name="person-telephone" @bind-Value="aboutYouForm.Telephone" />
</PageFields>

<PageFields IsVisible="@PageVisibility("email-page")">
    <GdsTextInputField Text="What is your email address?" Type="person-email" Name="email" @bind-Value="aboutYouForm.Email" />
</PageFields>

<PageFields IsVisible="@PageVisibility("summary-page")">
    <AboutYouSummary FormData="@aboutYouForm" OnNext="@(page => Next(page))" />
</PageFields>

<GdsButtonField Name="next-btn" OnClick="@Next">
    @(IsLastPage ? "Apply" : "Next")
</GdsButtonField>


@code {
    private AboutYou aboutYouForm = new AboutYou();
    private DateTime SelectedDate { get; set; } = DateTime.Now;

    protected override void OnInitialized()
    {
        PageNames = new string[]
        {
            "name-page",
            "dob-page",
            "address-page",
            "telephone-page",
            "email-page",
            "summary-page"
        };

        base.OnInitialized();
    }
}

