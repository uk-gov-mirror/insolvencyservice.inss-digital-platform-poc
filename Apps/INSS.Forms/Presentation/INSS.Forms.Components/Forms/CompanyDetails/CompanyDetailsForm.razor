@page "/company-details"
@inherits FormPagerBase

<PageTitle>Company Details</PageTitle>

<HeadingText Name="heading-company-details">Company Details</HeadingText>

<GdsBackField Name="back-btn" IsVisible="@(!IsFirstPage )" OnClick="@Back" />

<PageFields IsVisible="@PageVisibility(EntityNames.CompanyName)">
    <GdsTextInputField Text="@Questions.WhatIsYour(Labels.CompanyName)" Name="@EntityNames.CompanyName" @bind-Value="companyDetailsForm.CompanyName" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.CompanyType)">
    <GdsRadioButtonsField 
        Name="@EntityNames.CompanyType"
        Text="@Questions.WhatIsYour(Labels.CompanyType)"
        Items="@companyTypeOptions"
        Value="@companyDetailsForm.CompanyType.ToString()"
        ValueChanged="@(v => UpdateCompanyType(v))" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.CompaniesHouseReferenceNumber, ShouldCompaniesHouseReferenceNumberBeHidden)">
    <GdsTextInputField text="@Questions.WhatIsYour(Labels.CompaniesHouseReferenceNumber)" Name="@EntityNames.CompaniesHouseReferenceNumber" @bind-Value="companyDetailsForm.CompaniesHouseReferenceNumber" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.CharityReferenceNumber, ShouldCharityNumberBeHidden)">
    <GdsTextInputField text="@Questions.WhatIsYour(Labels.CharityReferenceNumber)" Name="@EntityNames.CharityReferenceNumber" @bind-Value="companyDetailsForm.CharityReferenceNumber" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.CompanyAddress)">
    <AddressFields Text="@Questions.WhatIsYour(Labels.CompanyAddress)" Name="@EntityNames.CompanyAddress" @bind-Value="companyDetailsForm.CompanyAddress" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.CompanyTelephone)">
    <GdsTextInputField Text="@Questions.WhatIsYour(Labels.CompanyTelephone)" Name="@EntityNames.CompanyTelephone" @bind-Value="companyDetailsForm.CompanyTelephone" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.Summary)">
    <CompanyDetailsSummary Name="@EntityNames.Summary" FormData="@companyDetailsForm" OnNext="@(page => Next(page))" />
</PageFields>

<GdsButtonField Name="next-btn" OnClick="@Next">
    @(IsLastPage ? "Apply" : "Next")
</GdsButtonField>

@code {
    private CompanyDetails companyDetailsForm = new CompanyDetails();

    private List<RadioOption<string>> companyTypeOptions = EnumHelper.ToRadioOptions<CompanyType>();

    protected override void OnInitialized()
    {
        PageNames = new string[]
        {
            EntityNames.CompanyName,
            EntityNames.CompanyType,
            EntityNames.CompaniesHouseReferenceNumber,
            EntityNames.CharityReferenceNumber,
            EntityNames.CompanyAddress,
            EntityNames.CompanyTelephone,
            EntityNames.Summary
        };
    }

    private bool ShouldCompaniesHouseReferenceNumberBeHidden()
    {
        return companyDetailsForm.CompanyType != CompanyType.LimitedCompany;
    }

    private bool ShouldCharityNumberBeHidden()
    {
        return companyDetailsForm.CompanyType != CompanyType.RegisteredCharity;
    }

    private void UpdateCompanyType(string value)
    {
        companyDetailsForm.CompanyType = Enum.Parse<CompanyType>(value);
        companyDetailsForm.CompaniesHouseReferenceNumber = string.Empty;
        companyDetailsForm.CharityReferenceNumber = string.Empty;
    }
}
