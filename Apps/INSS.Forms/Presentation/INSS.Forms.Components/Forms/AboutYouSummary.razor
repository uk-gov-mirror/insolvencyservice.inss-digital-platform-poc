<dl class="govuk-summary-list">
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
            Name
        </dt>
        <dd class="govuk-summary-list__value">
            @AboutYouData?.Name
        </dd>
        <dd class="govuk-summary-list__actions">
            <a class="govuk-link" href="#">Change<span class="govuk-visually-hidden"> name</span></a>
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
            Date of birth
        </dt>
        <dd class="govuk-summary-list__value">
            @AboutYouData?.DateOfBirth
        </dd>
        <dd class="govuk-summary-list__actions">
            <a class="govuk-link" href="#">Change<span class="govuk-visually-hidden"> date of birth</span></a>
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
            Address
        </dt>
        <dd class="govuk-summary-list__value">
            @AboutYouData?.Address.Address1<br />
            @AboutYouData?.Address.Address2<br /> 
            @AboutYouData?.Address.Town<br />
            @AboutYouData?.Address.Postcode<br />
        </dd>
        <dd class="govuk-summary-list__actions">
            <a class="govuk-link" href="#">Change<span class="govuk-visually-hidden"> address</span></a>
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
            Telephone
        </dt>
        <dd class="govuk-summary-list__value">
            @AboutYouData?.Telephone
        </dd>
        <dd class="govuk-summary-list__actions">
            <a class="govuk-link" href="#">Change<span class="govuk-visually-hidden"> telephone</span></a>
        </dd>
    </div>
    <div class="govuk-summary-list__row">
        <dt class="govuk-summary-list__key">
            Email
        </dt>
        <dd class="govuk-summary-list__value">
            @AboutYouData?.Email
        </dd>
        <dd class="govuk-summary-list__actions">
            <LinkButtonField
                Text="Change"
                AriaLabel="Change email address"
                NextParameter="email-page"
                OnNext="OnNext"
                Name="email-change"
                OnClick='() => OnNext.InvokeAsync("email-page")'/>
        </dd>
    </div>
</dl>



@code {
    [Parameter]
    public AboutYou? AboutYouData { get; set; }

    [Parameter]
    public EventCallback<string> OnNext { get; set; }
}

