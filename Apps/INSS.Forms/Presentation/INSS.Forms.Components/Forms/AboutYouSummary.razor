@inherits SummaryBase<AboutYou>

<dl class="govuk-summary-list">

    <SummaryRow Name="name" Text="Name" Values="@GetValue(FormData?.Name)" OnClick='() => OnNext.InvokeAsync("name-page")' />

    <SummaryRow Name="dob" Text="Date of birth" Values="@GetValue(FormData?.DateOfBirth?.ToString("dd MMM yyyy"))" OnClick='() => OnNext.InvokeAsync("dob-page")' />

    <SummaryRow 
        Name="address" 
        Text="Address"
        Values="@(new[] {
            FormData?.Address?.Address1 ?? string.Empty,
            FormData?.Address?.Address2 ?? string.Empty,
            FormData?.Address?.Town ?? string.Empty,
            FormData?.Address?.Postcode ?? string.Empty
        })"
        OnClick='() => OnNext.InvokeAsync("address-page")' 
     />

    <SummaryRow Name="telephone" Text="Telephone" Values="@GetValue(FormData?.Telephone)" OnClick='() => OnNext.InvokeAsync("telephone-page")' />

    <SummaryRow Name="email" Text="Email" Values="@GetValue(FormData?.Email)" OnClick='() => OnNext.InvokeAsync("email-page")' />

</dl>

