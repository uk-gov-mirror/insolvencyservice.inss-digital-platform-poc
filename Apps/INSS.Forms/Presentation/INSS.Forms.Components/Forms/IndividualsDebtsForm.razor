@page "/individuals-debts"
@inherits FormPagerBase

<PageTitle>Individual's Debts</PageTitle>

<HeadingText Name="heading-debts">Individual's Debts</HeadingText>

<GdsBackField Name="back-btn" IsVisible="@(!IsFirstPage )" OnClick="@Back" />

<PageFields IsVisible="@PageVisibility("creditor-name-page")">
    <GdsTextInputField Text="What is the creditor's name?" Name='$"creditor-name-{debtIndex}"' @bind-Value="individualsDebts.Debts[debtIndex].CreditorName" />
</PageFields>

<PageFields IsVisible="@PageVisibility("payment-frequency-page")">
    <GdsDCRadioButtonsField Name="payment-frequency"
        Text="How often do you make the payments?"
        Items="@paymentFrequencyOptions"
        Value="@individualsDebts.Debts[debtIndex].PaymentFrequency.ToString()"
        ValueChanged="@(v => individualsDebts.Debts[debtIndex].PaymentFrequency = Enum.Parse<PaymentFrequencyType>(v))" />
</PageFields>

<PageFields IsVisible="@(PageVisibility("initial-debt-page", ShouldInitialDebtBeHidden))">
    <GdsCurrencyInputField Text="What is the initial debt?" Name='$"initial-debt-{debtIndex}"' @bind-Value="individualsDebts.Debts[debtIndex].InitialDebt" />
</PageFields>

<PageFields IsVisible="@PageVisibility("date-debt-taken-out-page")">
    <GdsDateInputField Text="What date was the debt taken out?" Name='$"date-debt-taken-out-{debtIndex}"' @bind-Value="individualsDebts.Debts[debtIndex].DateDebtTakenOut" />
</PageFields>

<PageFields IsVisible="@PageVisibility("outstanding-debt-page")">
    <GdsCurrencyInputField Text="What is the outstanding debt?" Name='$"outstanding-debt-{debtIndex}"' @bind-Value="individualsDebts.Debts[debtIndex].OutstandingDebt" />
</PageFields>

<PageFields IsVisible="@PageVisibility("payment-amount-page")">
    <GdsCurrencyInputField Text="What is the payment amount?" Name='$"payment-amount-{debtIndex}"' @bind-Value="individualsDebts.Debts[debtIndex].PaymentAmount" />
</PageFields>


<PageFields IsVisible="@PageVisibility("debt-list-page")">
    <IndividualDebtsList 
        FormData="individualsDebts"
        AddNewText="Do you need to add another debt?"
        AddNewHint="You must tell us about all your debts."
        OnChange="@(page => Next(page))"
        OnRemove="@(page => Next(page))"
     />
</PageFields>

<GdsButtonField Name="next-btn" OnClick="@Next">
    @(IsLastPage ? "Apply" : "Next")
</GdsButtonField>


@code {

    private IndividualsDebts individualsDebts = null!;
    private int debtIndex = 0;

    private List<RadioOption<string>> paymentFrequencyOptions = EnumHelper.ToRadioOptions<PaymentFrequencyType>();

    protected override void OnInitialized()
    {
        PageNames = new string[]
        {
            "creditor-name-page",
            "payment-frequency-page",
            "initial-debt-page",
            "date-debt-taken-out-page",
            "outstanding-debt-page",
            "payment-amount-page",
            "debt-list-page"
        };

        individualsDebts = new IndividualsDebts();
        individualsDebts.Debts = new List<DebtItem>
        {
            new DebtItem()
        };

        base.OnInitialized();
    }
    private bool ShouldInitialDebtBeHidden()
    {
        return individualsDebts.Debts[debtIndex].PaymentFrequency == PaymentFrequencyType.monthly;
    }
}
