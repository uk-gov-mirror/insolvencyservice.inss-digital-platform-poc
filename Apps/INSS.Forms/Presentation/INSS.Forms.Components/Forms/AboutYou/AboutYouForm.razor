@page "/about-you"
@inherits InssFormBase

<PageTitle>About You</PageTitle>

<HeadingText Name="heading-about-you">About You</HeadingText>

<PreviousPageLink />

<Page Name="@EntityNames.Name">
    <GdsTextInputField Text="@Questions.WhatIsYour(Labels.Name)" Name="@EntityNames.Name" @bind-Value="aboutYouForm.Name" />
</Page>

<Page Name="@EntityNames.DateOfBirth">
    <GdsDateInputField Text="@Questions.WhatIsYour(Labels.DateOfBirth)" Name="@EntityNames.DateOfBirth" Hint="For example, 27 3 2007" @bind-Value="aboutYouForm.DateOfBirth" />
</Page>

<Page Name="@EntityNames.Address">
    <AddressFields Text="@Questions.WhatIsYour(Labels.Address)" Name="@EntityNames.Address" @bind-Value="aboutYouForm.Address" />
</Page>

<Page Name="@EntityNames.Telephone">
    <GdsTextInputField Text="@Questions.WhatIsYour(Labels.Telephone)" Name="@EntityNames.Telephone" @bind-Value="aboutYouForm.Telephone" />
</Page>

<Page Name="@EntityNames.Email">
    <GdsTextInputField Text="@Questions.WhatIsYour(Labels.Email)" Type="email" Name="@EntityNames.Email" @bind-Value="aboutYouForm.Email" />
</Page>

<Page Name="@EntityNames.Summary">
    <AboutYouSummary Name="@EntityNames.Summary" FormData="@aboutYouForm" OnNext="@(page => FormPageNavigationService.NextPage(page))" />
</Page>

<PageNavigationButton />


@code {

    private AboutYou aboutYouForm = new AboutYou();

    protected override void OnInitialized()
    {
        base.OnInitialized(aboutYouForm);
    }
}
