@page "/about-you"
@inherits FormPagerBase

<PageTitle>About You</PageTitle>

<HeadingText Name="heading-about-you">About You</HeadingText>

<GdsBackField Name="back-btn" IsVisible=@(!IsFirstPage) OnClick="@Back" />

<PageFields IsVisible="@PageVisibility(EntityNames.Name)">
    <GdsTextInputField Text="@Questions.WhatIsYour(Labels.Name)" Name="@EntityNames.Name" @bind-Value="aboutYouForm.Name" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.DateOfBirth)">
    <GdsDateInputField text="@Questions.WhatIsYour(Labels.DateOfBirth)" Name="@EntityNames.DateOfBirth" Hint="For example, 27 3 2007" @bind-Value="aboutYouForm.DateOfBirth" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.Address)">
    <AddressFields Text="@Questions.WhatIsYour(Labels.Address)" Name="@EntityNames.Address" @bind-Value="aboutYouForm.Address" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.Telephone)">
    <GdsTextInputField Text="@Questions.WhatIsYour(Labels.Telephone)" Name="@EntityNames.Telephone" @bind-Value="aboutYouForm.Telephone" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.Email)">
    <GdsTextInputField Text="@Questions.WhatIsYour(Labels.Email)" Type="email" Name="@EntityNames.Email" @bind-Value="aboutYouForm.Email" />
</PageFields>

<PageFields IsVisible="@PageVisibility(EntityNames.Summary)">
    <AboutYouSummary Name="@EntityNames.Summary" FormData="@aboutYouForm" OnNext="@(page => Next(page))" />
</PageFields>

<GdsButtonField Name="next-btn" OnClick="@Next">
    @(IsLastPage ? "Apply" : "Next")
</GdsButtonField>

@code {

    private AboutYou aboutYouForm = new AboutYou();
    private DateTime SelectedDate { get; set; } = DateTime.Now;

    protected override void OnInitialized()
    {
        aboutYouForm.FormMetadata = MetaDataFromLauncher;

        PageNames = new string[]
        {
            EntityNames.Name,
            EntityNames.DateOfBirth,
            EntityNames.Address,
            EntityNames.Telephone,
            EntityNames.Email,
            EntityNames.Summary
        };

        base.OnInitialized();
    }
}
