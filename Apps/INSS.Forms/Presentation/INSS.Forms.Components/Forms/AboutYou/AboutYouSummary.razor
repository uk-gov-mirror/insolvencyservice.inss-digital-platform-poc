@inherits SummaryBase<AboutYou>

<dl class="govuk-summary-list" id="@GenerateElementId()">

    <SummaryRow Name=@EntityNames.Name Text="Name" Values="@GetValue(FormData?.Name)" OnClick='() => OnNext.InvokeAsync(EntityNames.Name)' />

    <SummaryRow Name=@EntityNames.DateOfBirth Text="Date of birth" Values="@GetValue(FormData?.DateOfBirth?.ToString("dd MMM yyyy"))" OnClick='() => OnNext.InvokeAsync(EntityNames.DateOfBirth)' />

    <SummaryRow 
        Name=@EntityNames.Address 
        Text="Address"
        Values="@(new[] 
        {
            FormData?.Address?.Address1 ?? string.Empty,
            FormData?.Address?.Address2 ?? string.Empty,
            FormData?.Address?.Town ?? string.Empty,
            FormData?.Address?.Postcode ?? string.Empty
        })"
        OnClick='() => OnNext.InvokeAsync(EntityNames.Address)' 
     />

    <SummaryRow Name=@EntityNames.Telephone Text="Telephone" Values="@GetValue(FormData?.Telephone)" OnClick='() => OnNext.InvokeAsync(EntityNames.Telephone)' />

    <SummaryRow Name=@EntityNames.Email Text="Email" Values="@GetValue(FormData?.Email)" OnClick='() => OnNext.InvokeAsync(EntityNames.Email)' />

</dl>

