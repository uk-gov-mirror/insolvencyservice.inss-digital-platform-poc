@inherits SummaryBase<IndividualsDebts>

<HeadingText Name="heading-individuals-debts-list">
    @($"Change {FormData.Debts[DebtIndex].CreditorName}’s details")
</HeadingText>

<dl class="govuk-summary-list" id="@GenerateElementId()">

    <SummaryRow Name=@EntityNames.CreditorName
                Text="Creditor name"
                Values="@GetValue(debt.CreditorName)"
                OnClick='() => OnNext.InvokeAsync(EntityNames.CreditorName)' />

    <SummaryRow Name=@EntityNames.InitialDebt
                Text="Initial debt"
                Values="@GetValue(debt.InitialDebt.ToStringAsCurrency())"
                OnClick='() => OnNext.InvokeAsync(EntityNames.InitialDebt)' />

    <SummaryRow Name=@EntityNames.DateDebtTakenOut
                Text="Date debt taken out"
                Values="@GetValue(debt.DateDebtTakenOut?.ToString("dd MMM yyyy"))"
                OnClick='() => OnNext.InvokeAsync(EntityNames.DateDebtTakenOut)' />

    <SummaryRow Name=@EntityNames.OutstandingDebt
                Text="Outstanding debt"
                Values="@GetValue(debt.OutstandingDebt.ToStringAsCurrency())"
                OnClick='() => OnNext.InvokeAsync(EntityNames.OutstandingDebt)' />

    <SummaryRow Name=@EntityNames.PaymentFrequency
                Text="Payment frequency"
                Values="@GetValue(debt.PaymentFrequency.GetDescription())"
                OnClick='() => OnNext.InvokeAsync(EntityNames.PaymentFrequency)' />

    <SummaryRow Name=@EntityNames.PaymentAmount
                Text="Payment amount"
                Values="@GetValue(debt.PaymentAmount.ToStringAsCurrency())"
                OnClick='() => OnNext.InvokeAsync(EntityNames.PaymentAmount)' />

</dl>

@code {

    [Parameter]
    public int DebtIndex { get; set; } = 0;

    private DebtItem debt = null!;

    protected override Task OnParametersSetAsync()
    {
        debt = FormData.Debts[DebtIndex];

        return base.OnParametersSetAsync();
    }
}