@inherits SummaryBase<Debt>

<HeadingText Name="heading-individuals-debts-list">
    @($"Change {FormData.CreditorName}’s details")
</HeadingText>

<dl class="govuk-summary-list" id="@GenerateElementId()">

    <SummaryRow Name="@EntityNames.CreditorName"
                Text="@Labels.CreditorName"
                Values="@GetValue(FormData.CreditorName)"
                OnClick='() => OnNext.InvokeAsync(EntityNames.CreditorName)' />

    <SummaryRow Name="@EntityNames.InitialDebt"
                Text="@Labels.InitialDebt"
                Values="@GetValue(FormData.InitialDebt.ToStringAsCurrency())"
                OnClick='() => OnNext.InvokeAsync(EntityNames.InitialDebt)' />

    <SummaryRow Name="@EntityNames.DateDebtTakenOut"
                Text="@Labels.DateDebtTakenOut"
                Values="@GetValue(FormData.DateDebtTakenOut?.ToString("dd MMM yyyy"))"
                OnClick='() => OnNext.InvokeAsync(EntityNames.DateDebtTakenOut)' />

    <SummaryRow Name="@EntityNames.OutstandingDebt"
                Text="@Labels.OutstandingDebt"
                Values="@GetValue(FormData.OutstandingDebt.ToStringAsCurrency())"
                OnClick='() => OnNext.InvokeAsync(EntityNames.OutstandingDebt)' />

    <SummaryRow Name="@EntityNames.PaymentFrequency"
                Text="@Labels.PaymentFrequency"
                Values="@GetValue(FormData.PaymentFrequency.GetDescription())"
                OnClick='() => OnNext.InvokeAsync(EntityNames.PaymentFrequency)' />

    <SummaryRow Name="@EntityNames.PaymentAmount"
                Text="@Labels.PaymentAmount"
                Values="@GetValue(FormData.PaymentAmount.ToStringAsCurrency())"
                OnClick='() => OnNext.InvokeAsync(EntityNames.PaymentAmount)' />

</dl>

