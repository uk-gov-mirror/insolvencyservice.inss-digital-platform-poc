@page "/individuals-debts"
@inherits FormListBase<Debt>

<PageTitle>Individual's Debts</PageTitle>

<HeadingText Name="heading-debts">Individual's Debts</HeadingText>

<PreviousPageLink OnPrevious="@PreviousPageHandler" />

<Page Name="@EntityNames.CreditorName">
    <GdsTextInputField Text="@Questions.WhatIsThe(Labels.CreditorName)" Name="@IndexedName(EntityNames.CreditorName, ListIndex)" @bind-Value="individualsDebts.Debts[ListIndex].CreditorName" />
</Page>

<Page Name="@EntityNames.InitialDebt">
    <GdsCurrencyInputField Text="@Questions.WhatIsThe(Labels.InitialDebt)" Name="@IndexedName(EntityNames.InitialDebt, ListIndex)" @bind-Value="individualsDebts.Debts[ListIndex].InitialDebt" />
</Page>

<Page Name="@EntityNames.DateDebtTakenOut">
    <GdsDateInputField Text="@Questions.WhatDateWasThe(Labels.DebtTakenOut)" Name="@IndexedName(EntityNames.DateDebtTakenOut, ListIndex)" @bind-Value="individualsDebts.Debts[ListIndex].DateDebtTakenOut" />
</Page>

<Page Name="@EntityNames.OutstandingDebt">
    <GdsCurrencyInputField Text="@Questions.WhatIsThe(Labels.OutstandingDebt)" Name="@IndexedName(EntityNames.OutstandingDebt, ListIndex)" @bind-Value="individualsDebts.Debts[ListIndex].OutstandingDebt" />
</Page>

<Page Name="@EntityNames.PaymentFrequency">
    <GdsRadioButtonsField Name="@IndexedName(EntityNames.PaymentFrequency, ListIndex)"
        Text="How often do you make the payments?"
        Items="@paymentFrequencyOptions"
        Value="@individualsDebts.Debts[ListIndex].PaymentFrequency.ToString()"
        ValueChanged="@(v => individualsDebts.Debts[ListIndex].PaymentFrequency = Enum.Parse<PaymentFrequencyType>(v))" />
</Page>

<Page Name="@EntityNames.PaymentAmount">
    <GdsCurrencyInputField Text="What is the payment amount?" Name="@IndexedName(EntityNames.PaymentAmount, ListIndex)" @bind-Value="individualsDebts.Debts[ListIndex].PaymentAmount" />
</Page>


<Page Name="@EntityNames.List">
    <IndividualsDebtsList 
        Name="@EntityNames.List"
        FormData="individualsDebts"
        AddNewText="Do you need to add another debt?"
        AddNewHint="You must tell us about all your debts."
        OnAddNewChanged="@(value => AddNewChanged(value))"
        OnChange="@(index => ChangeItem(index))"
        OnRemove="@(index => ConfirmRemoveItem(index, individualsDebts.Debts[index].CreditorName))"
        @bind-Value="AddNewItemValue"
     />
</Page>

<Page Name="@EntityNames.ListChange" Hide="@(!ChangingItem)">
    <IndividualsDebtsListItem Name="@EntityNames.ListChange" FormData="individualsDebts.Debts[ListIndex]" OnNext="@(page => FormPageNavigationService.NextPage(page))" />
</Page>

<Page Name="@EntityNames.ConfirmAction" Hide="@(!RemovingItem)">
    <Confirm Name="@EntityNames.ConfirmAction" Text='@($"Are you sure you want to remove {KeyEntityValue} ?")' Value="@ConfirmValue" OnConfirmChanged="@ConfirmChanged" />
</Page>

<Page Name="@EntityNames.Summary">
    <IndividualsDebtsListSummary Name="@EntityNames.Summary" FormData="individualsDebts" OnClick="@(args => SkipTo(args.index, args.page))" />
</Page>

<PageNavigationButton IsDisabled="@IsNextButtonDisabled" OnNext="@(e => NextPageHandler(EntityNames.CreditorName))" />

@code {

    private IndividualsDebts individualsDebts = new IndividualsDebts { Debts = new List<Debt> { new Debt() } };
    private List<RadioOption<string>> paymentFrequencyOptions = EnumHelper.ToRadioOptions<PaymentFrequencyType>();

    protected override void OnInitialized()
    {
        ListItems = individualsDebts.Debts;

        base.OnInitialized(individualsDebts);
    }
}
