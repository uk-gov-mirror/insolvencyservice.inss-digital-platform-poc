@inherits InssComponentBase

<div class="govuk-summary-list__row" style="@displayStyle" id="@GenerateElementId()">
    <dt class="govuk-summary-list__key" id="@GenerateElementId("label")">
        @Text
    </dt>
    <dd class="govuk-summary-list__value" id="@GenerateElementId("value")">
        @foreach (var value in Values)
        {
            <span>@value</span>
            @if (value != Values.Last())
            {
                <br />
            }
        }
    </dd>

    <dd class="govuk-summary-list__actions" id="@GenerateElementId("action")">
        <a class="govuk-link" href="#" @onclick="OnClick">Change <span class="govuk-visually-hidden">@ariaLabel</span></a>
    </dd>
</div>

@code {



    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string[] Values { get; set; } = [];

    [Parameter]
    public bool IsVisible { get; set; } = true;

    [Parameter]
    public EventCallback<MouseEventArgs> OnClick { get; set; }

    private string ariaLabel => $"Change {Text.ToLower()}";

    private string linkButtonName => $"{Text.ToLower()}-change";

    private string displayStyle => IsVisible ? string.Empty : "display: none;";
}

