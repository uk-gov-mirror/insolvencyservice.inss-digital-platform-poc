@inherits RequiredAttributeBase

<div class="govuk-summary-list__row" id="@GenerateElementId("list-row")">
    <dt class="govuk-summary-list__key govuk-!-font-weight-regular hmrc-summary-list__key" id="@GenerateElementId("list-row-label")">
        @Text
    </dt>
    <dd class="govuk-summary-list__actions hmrc-summary-list__actions" id="@GenerateElementId("list-row-action")">
        <ul class="govuk-summary-list__actions-list" id="@GenerateElementId("list-row-action-list")">
            <li class="govuk-summary-list__actions-list-item" id="@GenerateElementId("list-row-action-list-change", "@Key")">
                <LinkButtonField Text="Change"
                    AriaLabel='@($"Change {Text}")'
                    Name='@($"{Text.ToLower()}-change")'
                    OnClick="OnChangeClick" />
@*                 <a class="govuk-link" href="#">
                    <span aria-hidden="true">
                        Change
                    </span>
                    <span class="govuk-visually-hidden">
                        Change @Text
                    </span>
                </a>
 *@            </li>
            <li class="govuk-summary-list__actions-list-item" id="@GenerateElementId("list-row-action-list-remove", "@Key")">
                <LinkButtonField Text="Remove"
                    AriaLabel='@($"Remove {Text}")'
                    Name='@($"{Text.ToLower()}-remove")'
                    OnClick="OnRemoveClick" />
   @*              <a class="govuk-link" href="#">
                    <span aria-hidden="true">
                        Remove
                    </span>
                    <span class="govuk-visually-hidden">
                        Remove @Text from the list
                    </span>
                </a>
 *@            </li>
        </ul>
    </dd>
</div>

@code {

    [Parameter]
    public string Key { get; set; } = string.Empty;

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<MouseEventArgs> OnChangeClick { get; set; }
    
    [Parameter]
    public EventCallback<MouseEventArgs> OnRemoveClick { get; set; }
}

