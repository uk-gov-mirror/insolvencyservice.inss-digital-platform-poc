@inherits InssComponentBase

<div class="govuk-summary-list__row" id="@GenerateElementId()">
    <dt class="govuk-summary-list__key govuk-!-font-weight-regular hmrc-summary-list__key" id="@GenerateElementId("label")">
        @Text
    </dt>
    <dd class="govuk-summary-list__actions hmrc-summary-list__actions" id="@GenerateElementId("action")">
        <ul class="govuk-summary-list__actions-list" id="@GenerateElementId("action-list")">
            <li class="govuk-summary-list__actions-list-item" id="@GenerateElementId("action-change", "@Key")">
                <a class="govuk-link" href="#" @onclick="OnChangeClick">Change <span class="govuk-visually-hidden">'@($"Change {Text}")'</span></a>
            </li>
            <li class="govuk-summary-list__actions-list-item" id="@GenerateElementId("action-remove", "@Key")">
                <a class="govuk-link govuk-link--no-visited-state" href="#" @onclick="OnRemoveClick">Remove <span class="govuk-visually-hidden">'@($"Remove {Text}")'</span></a>
            </li>
        </ul>
    </dd>
</div>

@code {

    [Parameter]
    public string Key { get; set; } = string.Empty;

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<MouseEventArgs> OnChangeClick { get; set; }
    
    [Parameter]
    public EventCallback<MouseEventArgs> OnRemoveClick { get; set; }
}

 