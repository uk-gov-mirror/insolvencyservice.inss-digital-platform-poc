@page "/address"

<fieldset class="govuk-fieldset">
    <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
        <h1 class="govuk-fieldset__heading">
            What is your address?
        </h1>
    </legend>

    <div class="govuk-form-group">
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label" for="address1">
                Address 1
            </label>
        </h1>
        <input class="govuk-input"
               id="address1"
               name="address1"
               type="text"
               placeholder=""
               title="Address 1"
               value="">
    </div>

    <div class="govuk-form-group">
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label" for="address2">
                Address 2
            </label>
        </h1>
        <input class="govuk-input"
               id="address2"
               name="address2"
               type="text"
               placeholder=""
               title="Address 2"
               value="">
    </div>

    <div class="govuk-form-group">
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label" for="town">
                Town
            </label>
        </h1>
        <input class="govuk-input"
               id="town"
               name="town"
               type="text"
               placeholder=""
               title="Town"
               value="">
    </div>

    <div class="govuk-form-group">
        <h1 class="govuk-label-wrapper">
            <label class="govuk-label" for="postcode">
                Postcode
            </label>
        </h1>
        <input class="govuk-input"
               id="postcode"
               name="postcode"
               type="text"
               placeholder=""
               title="Postcode"
               value="">
    </div>
</fieldset>


