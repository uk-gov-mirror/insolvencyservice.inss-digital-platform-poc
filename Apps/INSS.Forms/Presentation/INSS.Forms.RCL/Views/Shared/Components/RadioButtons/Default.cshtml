@model RadioButtonModel
@{
    var propertyName = Model.Name;
    var id = $"inss-forms-id-rb-group-{propertyName}";
    var validationMessage = ViewContext.ViewData.ModelState[propertyName]?.Errors.FirstOrDefault()?.ErrorMessage;
}

<div class="govuk-form-group" id="@(id)-group">
    <fieldset class="govuk-fieldset" aria-describedby="@(id)-hint">
        <legend class="govuk-fieldset__legend govuk-fieldset__legend--l">
            <InputTextHeading Name="heading-radios">
                @Model.Text
            </InputTextHeading>
        </legend>
        <div id="@(id)-hint" class="govuk-hint">
            @Model.Hint
        </div>
        <div class="govuk-radios @(Model.Inline ? "govuk-radios--inline" : "")" data-module="govuk-radios" id="@(id)-radios">
            @foreach (var item in @Model.Items)
            {
                <div class="govuk-radios__item" id="@(id)-radio-item">
                    <input class="govuk-radios__input"
                           id="@($"{id}-{@item.Value}")"
                           name="@propertyName"
                           type="radio"
                           value="@item.Value"
                           checked="@(Model.Value == item.Value)" />
                   
                    <label class="govuk-label govuk-radios__label" for="inss-forms-id-rb-group-label-@item.Value">
                        @item.Text
                    </label>
                </div>
            }
        </div>
        @if (!string.IsNullOrEmpty(validationMessage))
        {
            <span class="govuk-error-message">@validationMessage</span>
        }
    </fieldset>
</div>