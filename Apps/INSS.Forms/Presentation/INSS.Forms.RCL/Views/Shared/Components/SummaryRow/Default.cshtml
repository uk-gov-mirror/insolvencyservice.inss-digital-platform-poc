@using INSS.Forms.RCL.Models
@using INSS.Forms.Domain.Models.Constants

@model RowModel

<div class="govuk-summary-list__row" id="@($"{EntityNames.AppIdPrefix}-summary-row-{Model.Name}")">
    <dt class="govuk-summary-list__key" id="@($"{EntityNames.AppIdPrefix}-row-{Model.Name}-label")">
        @Model.Text
    </dt>
    <dd class="govuk-summary-list__value" id="@($"{EntityNames.AppIdPrefix}-summary-row-{Model.Name}-value")">
        @foreach (var value in Model.Values)
        {
            <span>@value</span>
            @if (value != Model.Values.Last())
            {
                <br />
            }
        }
    </dd>

    <dd class="govuk-summary-list__actions" id="@($"{EntityNames.AppIdPrefix}-summary-row-{Model.Name}-action")">

        <form method="post" asp-page-handler="Change">

            <input type="hidden" name="itemIndex" value="@Model.ItemIndex" />
            <input type="hidden" name="pageIndex" value="@Model.PageIndex" />

            <button type="submit" class="govuk-link" style="background:none;border:none;padding:0;color:#1d70b8;text-decoration:underline;cursor:pointer;font-size:1rem;">
                Change <span class="govuk-visually-hidden">@Model.AriaLabel</span>
            </button>
        </form>
    </dd>
</div>
