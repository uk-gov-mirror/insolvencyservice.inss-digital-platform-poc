@using INSS.Forms.RCL.Models
@using INSS.Forms.Domain.Models.Constants

@model RowModel

<div class="govuk-summary-list__row" id="@($"{EntityNames.AppIdPrefix}-list-row-{Model.Name}")">
    <dt class="govuk-summary-list__key govuk-!-font-weight-regular hmrc-summary-list__key" id="@($"{EntityNames.AppIdPrefix}-list-row-{Model.Name}-label")">
        @Model.Text
    </dt>
    <dd class="govuk-summary-list__actions hmrc-summary-list__actions" id="@($"{EntityNames.AppIdPrefix}-list-row-{Model.Name}-action")">
        <ul class="govuk-summary-list__actions-list" id="@($"{EntityNames.AppIdPrefix}-list-row-{Model.Name}-action-list")">
            <li class="govuk-summary-list__actions-list-item" id="@($"{EntityNames.AppIdPrefix}-list-row-{Model.Name}-action-change-{Model.ItemIndex}")">

                <form method="post" asp-page-handler="Change">

                    <input type="hidden" name="itemIndex" value="@Model.ItemIndex" />

                    <button type="submit" class="govuk-link" style="background:none;border:none;padding:0;color:#1d70b8;text-decoration:underline;cursor:pointer;font-size:1rem;">
                        Change <span class="govuk-visually-hidden">@Model.AriaLabel</span>
                    </button>
                </form>

            </li>
            <li class="govuk-summary-list__actions-list-item" id="@($"{EntityNames.AppIdPrefix}-list-row-{Model.Name}-action-remove-{Model.ItemIndex}")">

                <form method="post" asp-page-handler="Remove">

                    <input type="hidden" name="itemIndex" value="@Model.ItemIndex" />

                    <button type="submit" class="govuk-link" style="background:none;border:none;padding:0;color:#1d70b8;text-decoration:underline;cursor:pointer;font-size:1rem;">
                        Remove <span class="govuk-visually-hidden">@Model.AriaLabel</span>
                    </button>
                </form>

            </li>
        </ul>
    </dd>
</div>