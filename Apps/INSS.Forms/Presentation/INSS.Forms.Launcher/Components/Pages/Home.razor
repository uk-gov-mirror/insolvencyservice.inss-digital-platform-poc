@page "/"
@page "/{formSetInstanceId:guid?}"
@using INSS.Forms.Domain.Models.Abstract
@using System.Text.Json
@using System.Text.Json.Serialization
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient

<PageTitle>@pageTitle</PageTitle>

<br />

<GridContainerLayout Name="grid-container">

    @if (errors.Any())
    {
        <SummaryErrors Title="Service Error" Errors="@errors" Name="summary-error" />
    }

    @if (digitalService != null)
    {
        <RowTwoThirdsLayout Name="row-ds">
            <HeadingText Name="heading-ds">@digitalService.Title</HeadingText>
        </RowTwoThirdsLayout>

        @foreach (var digitalServiceSection in digitalService.DigitalServiceSections.OrderBy(section => section.SortOrder))
        {
            <RowTwoThirdsLayout Name="row-section">
                <SubHeadingText Name="section-name">@digitalServiceSection.Section.Name</SubHeadingText>
                <ParagraphText Name="section-description">@digitalServiceSection.Section.Description</ParagraphText>
            </RowTwoThirdsLayout>

            <GdsTaskListFieldMetadata 
                Name="section-forms" 
                Items="@GetTaskListItems(digitalServiceSection.Section.SectionForms.OrderBy(f => f.SortOrder), formInstances)" 
            />
        }

        <GdsButtonField Name="apply-btn" IsDisabled="@(!allFormsCompleted)" OnClick="@NavigateToCompletedPage">
            Apply
        </GdsButtonField>
    }

</GridContainerLayout>

@code {
    [Parameter]
    public Guid? formSetInstanceId { get; set; }

    private DigitalService? digitalService = null;
    private List<FormBase> formInstances = new();
    private List<string> errors = new();
    private string returnUrl = string.Empty;
    private string userName = Environment.UserName;
    private bool allFormsCompleted = false;
    private string pageTitle = "Launch Forms";

    /// <summary>
    /// Initializes the component, determines the digital service based on the host, and loads form instances if applicable.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        HttpContext? httpContext = HttpContextAccessor.HttpContext 
            ?? throw new InvalidOperationException("HttpContext is not available in the current context.");

        var hostHeader = httpContext.Request.Headers["Host"].ToString();

        string hostName = string.Empty;
        if (!string.IsNullOrEmpty(hostHeader))
        {
            int colonIndex = hostHeader.IndexOf(':');
            hostName = colonIndex > 0 ? hostHeader[..colonIndex] : hostHeader;
        }

        List<DigitalService>? digitalServices = GenerateDigitalServiceData();

        digitalService = digitalServices
            .SingleOrDefault(ds => ds.Name.ToUpperInvariant() == hostName.ToUpperInvariant());

        if (digitalService != null)
        {
            pageTitle = $"Launch {digitalService.Title}";

            if (formSetInstanceId.HasValue)
            {
                formInstances = await GetFormInstancesAsync(formSetInstanceId.Value);

                var dsForms = digitalService.DigitalServiceSections
                    .SelectMany(dsSection => dsSection.Section.SectionForms)
                    .Select(sectionForm => sectionForm.Form)
                    .Select(f => f.Id)
                    .ToList();

                allFormsCompleted = dsForms.All(formId => formInstances.Any(f => f.FormMetadata.FormId == formId));
            }
        }
        else
        {
            errors.Add($"Service not found for host: {hostName}");
        }

        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Retrieves the list of form instances for the specified form set instance identifier from the API.
    /// </summary>
    /// <param name="formSetInstanceId">The unique identifier for the form set instance.</param>
    /// <returns>A list of <see cref="FormBase"/> objects representing the form instances.</returns>
    private async Task<List<FormBase>> GetFormInstancesAsync(Guid formSetInstanceId)
    {
        string formApiBaseUrl = Configuration["FormApi-BaseUrl"]
            ?? throw new InvalidOperationException("The 'FormApi-BaseUrl' configuration value is missing.");

        var formApiUrl = $"{formApiBaseUrl}/forms/{formSetInstanceId}";

        try
        {
            var response = await HttpClient.GetAsync(formApiUrl);
            response.EnsureSuccessStatusCode();
            
            var json = await response.Content.ReadAsStringAsync();
            var formInstances = JsonSerializer.Deserialize<List<FormBase>>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                Converters = { new JsonStringEnumConverter() }
            });
            
            return formInstances ?? new List<FormBase>();
        }
        catch (Exception ex)
        {
            errors.Add($"API request failed: {ex.Message}");
            return new List<FormBase>();
        }
    }

    /// <summary>
    /// Navigates to the completed page with the current form set instance identifier.
    /// </summary>
    private void NavigateToCompletedPage()
    {
        NavigationManager.NavigateTo($"/completed/{formSetInstanceId}");
    }

    /// <summary>
    /// Generates a list of <see cref="TaskListItemMetadata"/> for the given section forms and form instances.
    /// </summary>
    /// <param name="sectionForms">The ordered collection of section forms.</param>
    /// <param name="formInstances">The list of form instances.</param>
    /// <returns>A read-only list of <see cref="TaskListItemMetadata"/> representing the task list items.</returns>
    private IReadOnlyList<TaskListItemMetadata> GetTaskListItems(IOrderedEnumerable<SectionForm> sectionForms, List<FormBase> formInstances)
    {
        string formRunnerBaseUrl = Configuration["FormRunner-BaseUrl"] 
            ?? throw new InvalidOperationException("The 'FormRunner-BaseUrl' configuration value is missing.");

        return sectionForms.Select(
            sf => {
                var uriBuilder = new UriBuilder(new Uri(new Uri(formRunnerBaseUrl), sf.Form.UriPath));
                if (formSetInstanceId.HasValue)
                {
                    var query = $"formSetInstanceId={formSetInstanceId.Value}";
                    uriBuilder.Query = string.IsNullOrEmpty(uriBuilder.Query) ? query : uriBuilder.Query.TrimStart('?') + "&" + query;
                }
                return new TaskListItemMetadata
                {
                    Id = sf.Form.Id,
                    FormId = sf.Form.Id,
                    Username = userName,
                    ReturnUrl = NavigationManager.Uri,
                    Title = sf.Form.FormName,
                    HRef = uriBuilder.ToString(),
                    Status = formInstances.Any(f => f.FormMetadata.FormId == sf.Form.Id) ? "Completed" : "Incomplete"
                };
            }).ToList();
    }

    /// <summary>
    /// Generates the digital service data for the application, including forms and sections.
    /// </summary>
    /// <returns>A list of <see cref="DigitalService"/> objects representing the available digital services.</returns>
    private List<DigitalService> GenerateDigitalServiceData()
    {
        Form aboutYouForm = new Form { Id = new Guid("9c8c8494-eaef-41f4-900a-55a0e9bfcc13"), FormName = "About You", UriPath = "about-you" };
        Form companyDetailsForm = new Form { Id = new Guid("47d7ac5d-00ec-4e46-baa6-f41e26f47fe6"), FormName = "Company Details", UriPath = "company-details" };
        Form individualsIncomeForm = new Form { Id = new Guid("e07e41f4-f3be-487b-aae8-304858356512"), FormName = "Individual's Income", UriPath = "individuals-income" };
        Form individualsDebtsForm = new Form { Id = new Guid("e65004dd-bba9-401d-b93e-3ca5de20394a"), FormName = "Individual's Debts", UriPath = "individuals-debts" };

        return new List<DigitalService>
        {
            new DigitalService
            {
                Id = Guid.NewGuid(),
                Name = "dro.local",
                Title = "Debt Relief Order",
                DigitalServiceSections = new List<DigitalServiceSection>
                {
                    new DigitalServiceSection
                    {
                        SortOrder = 1,
                        Section = new Section
                        {
                            Id = Guid.NewGuid(),
                            Name = "Personal Information",
                            Description = "Please provide your personal information to proceed with the application.",
                            SectionForms = new List<SectionForm>
                            {
                                new SectionForm
                                {
                                    Form = aboutYouForm,
                                    SortOrder = 1,
                                },
                                new SectionForm
                                {
                                    Form = companyDetailsForm,
                                    SortOrder = 2,
                                }
                            }
                        }
                    },
                    new DigitalServiceSection
                    {
                        SortOrder = 2,
                        Section = new Section
                        {
                            Id = Guid.NewGuid(),
                            Name = "Financial Information",
                            Description = "Please provide your financial information to proceed with the application.",
                            SectionForms = new List<SectionForm>
                            {
                                new SectionForm
                                {
                                    Form = individualsIncomeForm,
                                    SortOrder = 1,
                                },
                                new SectionForm
                                {
                                    Form = individualsDebtsForm,
                                    SortOrder = 2,
                                }
                            }
                        }
                    }
                }
            },
            new DigitalService
            {
                Id = Guid.NewGuid(),
                Name = "dcrs.local",
                Title = "Director Conduct Reporting Service",
                DigitalServiceSections = new List<DigitalServiceSection>
                {
                    new DigitalServiceSection
                    {
                        SortOrder = 1,
                        Section = new Section
                        {
                            Id = Guid.NewGuid(),
                            Name = "Your Information",
                            Description = "Please provide your information to proceed with the application.",
                            SectionForms = new List<SectionForm>
                            {
                                new SectionForm
                                {
                                    Form = aboutYouForm,
                                    SortOrder = 1,
                                }
                            },
                        }
                    },
                    new DigitalServiceSection
                    {
                        SortOrder = 2,
                        Section = new Section
                        {
                            Id = Guid.NewGuid(),
                            Name = "Your Salary & Income",
                            Description = "Please provide your company details and income information.",
                            SectionForms = new List<SectionForm>
                            {
                                new SectionForm
                                {
                                    Form = companyDetailsForm,
                                    SortOrder = 1,
                                },
                                new SectionForm
                                {
                                    Form = individualsIncomeForm,
                                    SortOrder = 2,
                                },
                            },
                        }
                    }
                }
            }
        };
    }
}
