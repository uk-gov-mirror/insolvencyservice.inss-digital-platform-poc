@page "/"
@page "/{formSetInstanceId:guid?}"
@using INSS.Forms.Domain.Models.Abstract
@using System.Text.Json
@using System.Text.Json.Serialization
@using INSS.Forms.Domain.Models.Composite
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient

<PageTitle>@pageTitle</PageTitle>

<br />

<GridContainerLayout Name="grid-container">

    @if (errors.Any())
    {
        <SummaryErrors Title="Service Error" Errors="@errors" Name="summary-error" />
    }

    @if (digitalService != null)
    {
        <RowTwoThirdsLayout Name="row-ds">
            <HeadingText Name="heading-ds">@digitalService.Title</HeadingText>
        </RowTwoThirdsLayout>

        @foreach (var digitalServiceSection in sections.OrderBy(section => section.SortOrder))
        {
            <RowTwoThirdsLayout Name="row-section">
                <SubHeadingText Name="section-name">@digitalServiceSection.Name</SubHeadingText>
                <ParagraphText Name="section-description">@digitalServiceSection.Description</ParagraphText>
            </RowTwoThirdsLayout>

            <GdsTaskListFieldMetadata 
                Name="section-forms" 
                Items="@(sectionTaskListItems.TryGetValue(digitalServiceSection.Id, out var items) ? items : Array.Empty<TaskListItemMetadata>())" 
            />
        }

        <GdsButtonField Name="apply-btn" IsDisabled="@(!allFormsCompleted)" OnClick="@NavigateToCompletedPage">
            Apply
        </GdsButtonField>
    }

</GridContainerLayout>

@code {
    [Parameter]
    public Guid? formSetInstanceId { get; set; }
    private DigitalService? digitalService = null;
    private List<OrderedSection> sections = new();
    private List<FormBase> formInstances = new();
    private List<string> errors = new();
    private string returnUrl = string.Empty;
    private string userName = Environment.UserName;
    private bool allFormsCompleted = false;
    private string pageTitle = "Launch Forms";
    private string formApiBaseUrl = string.Empty;
    private Dictionary<Guid, IReadOnlyList<TaskListItemMetadata>> sectionTaskListItems = new();

    protected override async Task OnInitializedAsync()
    {
        formApiBaseUrl = Configuration["FormApi-BaseUrl"]
            ?? throw new InvalidOperationException("The 'FormApi-BaseUrl' configuration value is missing.");

        var hostHeader = HttpContextAccessor.HttpContext!.Request.Headers["Host"].ToString();

        string hostName = string.Empty;
        if (!string.IsNullOrEmpty(hostHeader))
        {
            int colonIndex = hostHeader.IndexOf(':');
            hostName = colonIndex > 0 ? hostHeader[..colonIndex] : hostHeader;
        }

        digitalService = await GetDigitalServiceAsync(hostName).ConfigureAwait(false);

        if (digitalService != null)
        {
            IEnumerable<Guid> formIds = new List<Guid>();
            if (formSetInstanceId.HasValue)
            {
                formInstances = await GetFormInstancesAsync(formSetInstanceId.Value).ConfigureAwait(false);
                formIds = await GetDigitalServiceFormIdsAsync(digitalService.Id).ConfigureAwait(false);
            }

            sections = (await GetSectionsAsync(digitalService.Id).ConfigureAwait(false)).ToList();
            var sectionTasks = sections.Select(section => GetTaskListItemsAsync(section.Id, formInstances)).ToList();
            var allItems = await Task.WhenAll(sectionTasks);

            sectionTaskListItems = sections
                .Select((section, idx) => new { section.Id, Items = allItems[idx] })
                .ToDictionary(x => x.Id, x => (IReadOnlyList<TaskListItemMetadata>)x.Items);

            pageTitle = $"Launch {digitalService.Title}";
            allFormsCompleted = formIds.All(formId => formInstances.Any(f => f.FormMetadata.FormId == formId));
        }
        else
        {
            errors.Add($"Service not found for host: {hostName}");
        }

        await base.OnInitializedAsync();
    }

    /// <summary>
    /// Retrieves the list of form instances for the specified form set instance identifier.
    /// </summary>
    /// <param name="formSetInstanceId">The unique identifier of the form set instance.</param>
    /// <returns>
    /// A <see cref="Task{TResult}"/> representing the asynchronous operation, with a result of a list of <see cref="FormBase"/> objects.
    /// Returns an empty list if no form instances are found or if the API call fails.
    /// </returns>
    private async Task<List<FormBase>> GetFormInstancesAsync(Guid formSetInstanceId)
    {
        var formsApiUrl = $"{formApiBaseUrl}/forms/{formSetInstanceId}";

        return await CallApiAsync<List<FormBase>>(formsApiUrl).ConfigureAwait(false) ?? new List<FormBase>();
    }

    /// <summary>
    /// Retrieves the digital service configuration for the specified host name.
    /// </summary>
    /// <param name="hostName">The host name to look up the digital service for.</param>
    /// <returns>
    /// A <see cref="Task{TResult}"/> representing the asynchronous operation, with a result of a <see cref="DigitalService"/> object if found; otherwise, <c>null</c>.
    /// </returns>
    private async Task<DigitalService?> GetDigitalServiceAsync(string hostName)
    {
        var configApiUrl = $"{formApiBaseUrl}/configuration/digital-service/{hostName}";

        return await CallApiAsync<DigitalService>(configApiUrl).ConfigureAwait(false);
    }

    /// <summary>
    /// Retrieves the collection of form definition identifiers associated with the specified digital service.
    /// </summary>
    /// <param name="digitalServiceId">The unique identifier of the digital service.</param>
    /// <returns>
    /// A <see cref="Task{TResult}"/> representing the asynchronous operation, with a result of an enumerable of <see cref="Guid"/> values.
    /// Returns an empty array if no form IDs are found or if the API call fails.
    /// </returns>
    private async Task<IEnumerable<Guid>> GetDigitalServiceFormIdsAsync(Guid digitalServiceId)
    {
        var configApiUrl = $"{formApiBaseUrl}/configuration/digital-service/{digitalServiceId}/formids";

        return await CallApiAsync<IEnumerable<Guid>>(configApiUrl).ConfigureAwait(false) ?? Array.Empty<Guid>();
    }

    /// <summary>
    /// Retrieves the ordered sections associated with the specified digital service.
    /// </summary>
    /// <param name="digitalServiceId">The unique identifier of the digital service.</param>
    /// <returns>
    /// A <see cref="Task{TResult}"/> representing the asynchronous operation, with a result of an enumerable of <see cref="OrderedSection"/> objects.
    /// Returns an empty array if no sections are found or if the API call fails.
    /// </returns>
    private async Task<IEnumerable<OrderedSection>> GetSectionsAsync(Guid digitalServiceId)
    {
        var configApiUrl = $"{formApiBaseUrl}/configuration/digital-service/{digitalServiceId}/sections";

        return await CallApiAsync<IEnumerable<OrderedSection>>(configApiUrl).ConfigureAwait(false) ?? Array.Empty<OrderedSection>();
    }

    /// <summary>
    /// Retrieves the ordered forms associated with the specified section.
    /// </summary>
    /// <param name="sectionId">The unique identifier of the section.</param>
    /// <returns>
    /// A <see cref="Task{TResult}"/> representing the asynchronous operation, with a result of a list of <see cref="OrderedForm"/> objects.
    /// Returns an empty array if no forms are found or if the API call fails.
    /// </returns>
    private async Task<IList<OrderedForm>> GetSectionFormsAsync(Guid sectionId)
    {
        var configApiUrl = $"{formApiBaseUrl}/configuration/section/{sectionId}/forms";

        return await CallApiAsync<IList<OrderedForm>>(configApiUrl).ConfigureAwait(false) ?? Array.Empty<OrderedForm>();
    }

    /// <summary>
    /// Makes an HTTP GET request to the specified API URL and deserializes the response to the specified type.
    /// Handles common HTTP and deserialization errors, adding error messages to the <c>errors</c> list.
    /// </summary>
    /// <typeparam name="T">The type to deserialize the response to.</typeparam>
    /// <param name="apiUrl">The URL of the API endpoint.</param>
    /// <returns>
    /// A <see cref="Task{TResult}"/> representing the asynchronous operation, with a result of the deserialized object of type <typeparamref name="T"/>.
    /// Returns <c>default(T)</c> if the resource is not found or if an error occurs.
    /// </returns>
    private async Task<T?> CallApiAsync<T>(string apiUrl)
    {
        string json = string.Empty;

        try
        {
            var response = await HttpClient.GetAsync(apiUrl);

            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                return default(T);
            }

            response.EnsureSuccessStatusCode();

            json = await response.Content.ReadAsStringAsync();
            var deserialized = JsonSerializer.Deserialize<T>(json, new JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true,
                Converters = { new JsonStringEnumConverter() }
            });

            return deserialized;

        }
        catch (HttpRequestException ex)
        {
            errors.Add($"The HTTP request failed calling:{apiUrl}");
            errors.Add(ex.Message);
        }
        catch (TaskCanceledException)
        {
            errors.Add($"Request timed out or was canceled calling:{apiUrl}");
        }
        catch (JsonException ex)
        {
            errors.Add($"Deserialization failed for JSON: {json}");
            errors.Add(ex.Message);
        }
        catch (Exception ex)
        {
            errors.Add($"Failed to return objects from API: {apiUrl}");
            errors.Add(ex.Message);
        }

        return default(T);
    }

    /// <summary>
    /// Retrieves the list of task list items for a given section, including completion status and navigation links.
    /// </summary>
    /// <param name="sectionId">The unique identifier of the section for which to retrieve forms.</param>
    /// <param name="formInstances">A list of form instances representing completed or in-progress forms.</param>
    /// <returns>
    /// A <see cref="Task{TResult}"/> representing the asynchronous operation, with a result of a read-only list of <see cref="TaskListItemMetadata"/> objects.
    /// Each item contains metadata for a form in the section, including its completion status and navigation URI.
    /// </returns>
    private async Task<IReadOnlyList<TaskListItemMetadata>> GetTaskListItemsAsync(Guid sectionId, List<FormBase> formInstances)
    {
        string formRunnerBaseUrl = Configuration["FormRunner-BaseUrl"] 
            ?? throw new InvalidOperationException("The 'FormRunner-BaseUrl' configuration value is missing.");

        var forms = (await GetSectionFormsAsync(sectionId).ConfigureAwait(false))
            .OrderBy(f => f.SortOrder);

        var result = forms.Select(
            form =>
            {
                var uriBuilder = new UriBuilder(new Uri(new Uri(formRunnerBaseUrl), form.UriPath));
                if (formSetInstanceId.HasValue)
                {
                    var query = $"formSetInstanceId={formSetInstanceId.Value}";
                    uriBuilder.Query = string.IsNullOrEmpty(uriBuilder.Query) ? query : uriBuilder.Query.TrimStart('?') + "&" + query;
                }
                return new TaskListItemMetadata
                {
                    Id = form.Id,
                    FormId = form.Id,
                    Username = userName,
                    ReturnUrl = NavigationManager.Uri,
                    Title = form.Name,
                    HRef = uriBuilder.ToString(),
                    Status = formInstances.Any(formInstance => formInstance.FormMetadata.FormId == form.Id) ? "Completed" : "Incomplete"
                };
            }).ToList();

        return result;
    }

    /// <summary>
    /// Navigates to the completed page with the current form set instance identifier.
    /// </summary>
    private void NavigateToCompletedPage()
    {
        NavigationManager.NavigateTo($"/completed/{formSetInstanceId}");
    }
}
