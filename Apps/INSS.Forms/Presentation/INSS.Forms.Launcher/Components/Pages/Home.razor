@page "/"
@inject IHttpContextAccessor HttpContextAccessor
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager

<PageTitle>Forms Launcher</PageTitle>

<br />

<GridContainerLayout Name="grid-container">

    @if (errors.Any())
    {
        <SummaryErrors Title="Service Error" Errors="@errors" Name="summary-error" />
    }

    @if (digitalService != null)
    {
        <RowTwoThirdsLayout Name="row-ds">
            <HeadingText Name="heading-ds">@digitalService.Title</HeadingText>
        </RowTwoThirdsLayout>

        @foreach (var digitalServiceSection in digitalService.DigitalServiceSections.OrderBy(section => section.SortOrder))
        {
            <RowTwoThirdsLayout Name="row-section">
                <SubHeadingText Name="section-name">@digitalServiceSection.Section.Name</SubHeadingText>
                <ParagraphText Name="section-description">@digitalServiceSection.Section.Description</ParagraphText>
            </RowTwoThirdsLayout>

            <GdsTaskListFieldMetadata 
                Name="section-forms" 
                Items="@GetTaskListItems(digitalServiceSection.Section.SectionForms.OrderBy(f => f.SortOrder))" 
            />
        }

        <GdsButtonField Name="apply-btn" IsDisabled="true">
            Apply
        </GdsButtonField>
    }

</GridContainerLayout>


@code {

    private DigitalService? digitalService = null;
    private List<string> errors = new();
    private string returnUrl = string.Empty;
    private string userName = Environment.UserName;

    // OnInitializedAsync is a lifecycle method in Blazor components that runs when the component is initialized. 
    // It’s the asynchronous version of OnInitialized. Use it when you need to perform async operations (like fetching data from a service or API) during component initialization. 
    // In this example we are simply retrieving the Host header from the HTTP context, so it does not need to be async, this is async just for demo/kb purposes.
    protected override async Task OnInitializedAsync()
    {
        HttpContext? httpContext = HttpContextAccessor.HttpContext 
            ?? throw new InvalidOperationException("HttpContext is not available in the current context.");

        var hostHeader = httpContext.Request.Headers["Host"].ToString();

        string hostName = string.Empty;
        if (!string.IsNullOrEmpty(hostHeader))
        {
            int colonIndex = hostHeader.IndexOf(':');
            hostName = colonIndex > 0 ? hostHeader[..colonIndex] : hostHeader;
        }

        List<DigitalService>? digitalServices = GenerateDigitalServiceData();

        digitalService = digitalServices
            .SingleOrDefault(ds => ds.Name.ToUpperInvariant() == hostName.ToUpperInvariant());

        if (digitalService == null)
        {
            errors.Add($"Service not found for host: {hostName}");
        }

        await base.OnInitializedAsync();
    }

    private IReadOnlyList<TaskListItemMetadata> GetTaskListItems(IOrderedEnumerable<SectionForm> sectionForms)
    {
        string formRunnerBaseUrl = Configuration["FormRunner-BaseUrl"] 
            ?? throw new InvalidOperationException("The 'FormRunner-BaseUrl' configuration value is missing.");

        return sectionForms.Select(
            sf => new TaskListItemMetadata
                {
                    Id = sf.Form.Id,
                    FormId = sf.Form.Id,
                    Username = userName,
                    ReturnUrl = NavigationManager.Uri,
                    Title = sf.Form.FormName,
                    HRef = new Uri(new Uri(formRunnerBaseUrl), sf.Form.UriPath).ToString(),
                    Status = "Incomplete"
                    
                }).ToList();
    }

    private List<DigitalService> GenerateDigitalServiceData()
    {
        return new List<DigitalService>
        {
            new DigitalService
            {
                Id = Guid.NewGuid(),
                Name = "dro.local",
                Title = "Debt Relief Order",
                DigitalServiceSections = new List<DigitalServiceSection>
                {
                    new DigitalServiceSection
                    {
                        SortOrder = 1,
                        Section = new Section
                        {
                            Id = Guid.NewGuid(),
                            Name = "Personal Information",
                            Description = "Please provide your personal information to proceed with the application.",
                            SectionForms = new List<SectionForm>
                            {
                                new SectionForm
                                {
                                    Form = GenerateForm("About You", "about-you"),
                                    SortOrder = 1,
                                },
                                new SectionForm
                                {
                                    Form = GenerateForm("Company Details", "company-details"),
                                    SortOrder = 2,
                                }
                            }
                        }
                    },
                    new DigitalServiceSection
                    {
                        SortOrder = 2,
                        Section = new Section
                        {
                            Id = Guid.NewGuid(),
                            Name = "Financial Information",
                            Description = "Please provide your financial information to proceed with the application.",
                            SectionForms = new List<SectionForm>
                            {
                                new SectionForm
                                {
                                    Form = GenerateForm("Individual's Income", "individuals-income"),
                                    SortOrder = 1,
                                },
                                new SectionForm
                                {
                                    Form = GenerateForm("Individual's Debts", "individuals-debts"),
                                    SortOrder = 2,
                                }
                            }
                        }
                    }
                }
            },
            new DigitalService
            {
                Id = Guid.NewGuid(),
                Name = "dcrs.local",
                Title = "Director Conduct Reporting Service",
                DigitalServiceSections = new List<DigitalServiceSection>
                {
                    new DigitalServiceSection
                    {
                        SortOrder = 1,
                        Section = new Section
                        {
                            Id = Guid.NewGuid(),
                            Name = "Personal Information",
                            Description = "Please provide your personal information to proceed with the application.",
                            SectionForms = new List<SectionForm>
                            {
                                new SectionForm
                                {
                                    Form = GenerateForm("About You", "about-you"),
                                    SortOrder = 1,
                                }
                            },
                        }
                    },
                    new DigitalServiceSection
                    {
                        SortOrder = 2,
                        Section = new Section
                        {
                            Id = Guid.NewGuid(),
                            Name = "Financial Information",
                            Description = "Please provide your company and financial information to proceed with the application.",
                            SectionForms = new List<SectionForm>
                            {
                                new SectionForm
                                {
                                    Form = GenerateForm("Company Details", "company-details"),
                                    SortOrder = 1,
                                },
                                new SectionForm
                                {
                                    Form = GenerateForm("Individual's Income", "individuals-income"),
                                    SortOrder = 2,
                                },
                            },
                        }
                    }
                }
            }
        };
    }

    private static Form GenerateForm(string name, string uriPath)
    {
        return new Form
            {
                Id = Guid.NewGuid(),
                FormName = name,
                UriPath = uriPath
            };
    }

}
