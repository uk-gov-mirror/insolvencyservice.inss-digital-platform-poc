@page "/completed/{formSetInstanceId:guid?}"


<div class="govuk-width-container">
    <main class="govuk-main-wrapper govuk-main-wrapper--l" id="main-content" role="main">
        <div class="govuk-grid-row">
            <div>
                <div class="govuk-panel govuk-panel--confirmation">
                    <h1 class="govuk-panel__title">
                        Application complete
                    </h1>
                    <div class="govuk-panel__body">
                        Your reference number<br><strong>@(formSetInstanceId.ToString().Split('-').Last().ToUpperInvariant())</strong>
                    </div>
                </div>
                <p class="govuk-body">We have sent you a confirmation email.</p>
                <h2 class="govuk-heading-m">What happens next</h2>
                <p class="govuk-body">
                    We’ve sent your application to the applicable service.
                </p>
                <p class="govuk-body">
                    They will contact you either to confirm your registration, or to ask for more information.
                </p>
                <br /><br /><br />
                <p class="govuk-body">
                    Why not try another service:<br /><br />
                    <a href="https://dro.local:6001" class="govuk-link">Debt Relief Order Application</a><br />
                    <a href="https://dcrs.local:6001" class="govuk-link">Director Conduct Reporting Service Application</a>
                </p>
            </div>
        </div>
    </main>
</div>


@code {
    [Parameter]
    public Guid formSetInstanceId { get; set; }
}
