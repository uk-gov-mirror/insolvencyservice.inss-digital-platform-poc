<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <PropertyGroup>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

    <!--
    Inspect this path to view the c# files generated from your Razor components.
    This can be usefiul for debugging purposes and identifying bottlenecks.
    -->
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!--
    This allows you to use scoped CSS in your Blazor components.
    e.g. for GdsCurrencyInput component create a file named GdsCurrencyInput.razor.css
    -->
    <EnableDefaultScopedCssItems>true</EnableDefaultScopedCssItems>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\Domain\Models\INSS.Forms.Domain.Models\INSS.Forms.Domain.Models.csproj" />
    <ProjectReference Include="..\INSS.Forms.BCL\INSS.Forms.BCL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="SelfSignedCerts\dcrs.local.pfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="SelfSignedCerts\dro.local.pfx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
