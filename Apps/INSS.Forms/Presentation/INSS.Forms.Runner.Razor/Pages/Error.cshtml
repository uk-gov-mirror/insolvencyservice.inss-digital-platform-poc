@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger govuk-heading-l">Error.</h1>
<h2 class="text-danger govuk-heading-m">An error occurred while processing your request.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Error :</strong> <code>@Model.RequestId</code>
    </p>
}


@if (TempData["ErrorCode"] != null)
{
    <p class="govuk-error-message">
        <strong>Error Code: </strong> <code>@TempData["ErrorCode"]</code>
    </p>
}

@if (TempData["ErrorMessage"] != null)
{
    <p class="govuk-error-message">
        @TempData["ErrorMessage"]
    </p>
}

