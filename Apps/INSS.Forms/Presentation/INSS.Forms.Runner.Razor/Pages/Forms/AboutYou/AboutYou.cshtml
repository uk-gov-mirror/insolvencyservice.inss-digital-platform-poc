@page "/about-you"
@model AboutYouModel


<vc:heading text="About You" />

<vc:previous-button current-page-index="Model.PageIndex" />

<form method="post">

    @if (Model.PageIndex == 0)
    {
        <vc:input name="Form.Name" label="What is your name?" value="@Model.Form.Name" />
    }

    @if (Model.PageIndex == 1)
    {
        <vc:address model="@Model.Form.Address" />
    }

    @if (Model.PageIndex == 2)
    {
        <vc:input name="Form.Telephone" label="What is your telephone?" input-type="@InputComponentType.Telephone" value="@Model.Form.Telephone" />
    }

    @if (Model.PageIndex == 3)
    {
        <vc:input name="Form.Email" label="What is your email" input-type="@InputComponentType.Email" value="@Model.Form.Email" />
    }

    <vc:button model="@(new ButtonModel { Text = "Next" })" />

</form>
