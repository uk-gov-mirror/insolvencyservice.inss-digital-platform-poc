@model INSS.Forms.Analytics.Models.AboutYouViewModel

<form method="post">
    <govuk-input for="@Model.FirstName" input-class="govuk-input--width-30" inputmode="text" spellcheck="false">
        <govuk-input-label is-page-heading="true" class="govuk-label--l">What is your first name?</govuk-input-label>
        <govuk-input-hint>Enter your first name</govuk-input-hint>
    </govuk-input>
    <govuk-button type="submit">Continue</govuk-button>
</form>
