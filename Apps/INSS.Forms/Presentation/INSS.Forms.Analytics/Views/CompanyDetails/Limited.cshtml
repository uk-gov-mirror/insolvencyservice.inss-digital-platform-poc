@model INSS.Forms.Analytics.Models.CompanyDetailsViewModel

<form method="post">
    <govuk-input for="@Model.LimitedNumber" input-class="govuk-input--width-30" inputmode="text" spellcheck="false">
        <govuk-input-label is-page-heading="true" class="govuk-label--l">What is your limited company number?</govuk-input-label>
        <govuk-input-hint>Enter your company number</govuk-input-hint>
    </govuk-input>
    <govuk-button type="submit">Continue</govuk-button>
</form>
