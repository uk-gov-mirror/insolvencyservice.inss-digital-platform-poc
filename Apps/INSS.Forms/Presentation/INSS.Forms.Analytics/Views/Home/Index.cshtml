@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="govuk-heading-xl">Analytics Demo</h1>

    <govuk-details>
        <govuk-details-summary>
            Learn how this app captures analytics to improve user experience.
        </govuk-details-summary>
        <govuk-details-text>
            <p>
                This app demonstrates how analytics can be captured to gain insights into user behavior and application performance.
            </p>
            <p>
                By tracking specific events—such as page views, button clicks, and form submissions—you can measure user engagement and identify areas for improvement.
            </p>
            <p>
                The application also illustrates how these events can be sent to analytics services, enabling the registration of goals (such as successful sign-ups or purchases) and the creation of funnels to visualize the steps users take before completing a desired action.
            </p>
            <p>
                This approach helps you optimize your app and make data-driven decisions.
            </p>
        </govuk-details-text>
    </govuk-details>

    <p class="govuk-body">
        See our <a href="/Home/Privacy" class="govuk-link">Privacy Policy</a> for further details.
    </p>
</div>
