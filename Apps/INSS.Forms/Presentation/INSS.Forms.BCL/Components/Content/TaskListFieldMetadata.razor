@inherits InssComponentBase

<ul class="govuk-task-list" id="@GenerateElementId()">
    @foreach(var item in Items)
    {
        <li class="govuk-task-list__item govuk-task-list__item--with-link" id="@GenerateElementId($"list-item", item.Id.ToString("N"))">
            <div class="govuk-task-list__name-and-hint" id="@GenerateElementId($"list-item-hint", item.Id.ToString("N"))">
                <a class="govuk-link govuk-task-list__link"
                   href="@AssembleUrl(item)"
                aria-describedby="@GenerateElementId($"list-item-status", item.Id.ToString("N"))"
                id="@GenerateElementId($"list-item-link", item.Id.ToString("N"))">
                    @item.Title
                </a>
            </div>
            <div class="govuk-task-list__status" id="@GenerateElementId($"list-item-status", item.Id.ToString("N"))">
                @item.Status
            </div>
        </li>
    }
</ul>

@code {

    [EditorRequired]
    [Parameter] 
    public IReadOnlyList<TaskListItemMetadata> Items { get; set; } = Array.Empty<TaskListItemMetadata>();

    private string AssembleUrl(TaskListItemMetadata taskListItem)
    {
        var uriBuilder = new UriBuilder(taskListItem.HRef);
        var queryParams = new List<string>();

        if (!string.IsNullOrEmpty(taskListItem.ReturnUrl))
            queryParams.Add($"ReturnUrl={Uri.EscapeDataString(taskListItem.ReturnUrl)}");

        if (taskListItem.FormId != Guid.Empty)
            queryParams.Add($"Form={Uri.EscapeDataString(taskListItem.FormId.ToString())}");

        if (!string.IsNullOrEmpty(taskListItem.Username))
            queryParams.Add($"Username={Uri.EscapeDataString(taskListItem.Username)}");

        if (!string.IsNullOrEmpty(uriBuilder.Query) && uriBuilder.Query.Length > 1)
        {
            queryParams.Insert(0, uriBuilder.Query.Substring(1));
        }

        uriBuilder.Query = string.Join("&", queryParams);

        return uriBuilder.Uri.AbsoluteUri;
    }
}
