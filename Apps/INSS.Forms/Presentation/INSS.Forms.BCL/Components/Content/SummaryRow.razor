@inherits InssComponentBase

<div class="govuk-summary-list__row" style="@displayStyle" id="@GenerateElementId(Name)">
    <dt class="govuk-summary-list__key" id="@GenerateElementId("label", Name)">
        @Text
    </dt>
    <dd class="govuk-summary-list__value" id="@GenerateElementId("value", Name)">
        @foreach (var value in Values)
        {
            <span>@value</span>
            @if (value != Values.Last())
            {
                <br />
            }
        }
    </dd>

    <dd class="govuk-summary-list__actions" id="@GenerateElementId("action", Name)">

        <form @formname="@($"form-income-list-change-{Name}")" method="post" @onsubmit="OnSubmitChange">
            <AntiforgeryToken />
            <button type="submit" class="govuk-link" style="background:none;border:none;padding:0;color:#1d70b8;text-decoration:underline;cursor:pointer;font-size:1rem;">
                Change <span class="govuk-visually-hidden">@Text</span>
            </button>
        </form>

    </dd>
</div>

@code {

    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string[] Values { get; set; } = [];

    [Parameter]
    public bool IsVisible { get; set; } = true;

    [Parameter]
    public EventCallback<(int, int)> OnChange { get; set; }

    private string ariaLabel => $"Change {Text.ToLower()}";

    private string linkButtonName => $"{Text.ToLower()}-change";

    private string displayStyle => IsVisible ? string.Empty : "display: none;";

    private async Task OnSubmitChange()
    {
        await OnChange.InvokeAsync();
    }
}

