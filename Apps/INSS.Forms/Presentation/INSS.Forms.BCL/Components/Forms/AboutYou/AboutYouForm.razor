@page "/about-you"
@inherits InssFormBase<AboutYou>

<HeadingText Name="@EntityNames.HeadingText">@Resource.AboutYouTitle</HeadingText>

<PreviousButton Name="@EntityNames.PreviousButton" />

<EditForm Enhance EditContext="CurrentEditContext" FormName="@FormName" OnValidSubmit="OnNext">

    @if(PageIndex == 0)
    {
        <ValidatedInput Text="@Questions.WhatIsYour(Labels.Name)" Name="@FieldName(nameof(Form.Name))" Value="@Form.Name" ValidateFor="() => Form.Name" />
    }

    @if (PageIndex == 1)
    {
        <AddressInput Text="@Questions.WhatIsYour(Labels.Address)" Name="@FieldName(nameof(Form.Address))" Value="@Form.Address" />
    }

    @if(PageIndex == 2)
    {
        <ValidatedInput Text="@Questions.WhatIsYour(Labels.Telephone)" Name="@FieldName(nameof(Form.Telephone))" Value="@Form.Telephone" Type="@InputFieldType.Telephone" ValidateFor="() => Form.Telephone" />
    }

    @if (PageIndex == 3)
    {
        <ValidatedInput Text="@Questions.WhatIsYour(Labels.Email)" Name="@FieldName(nameof(Form.Email))" Value="@Form.Email" Type="@InputFieldType.Email" ValidateFor="() => Form.Email" />
    }

    <SubmitButton Name="@EntityNames.NextButton" Text="@(PageIndex == 3 ? Resource.Save : Resource.Next)" />

</EditForm>

@code {

    protected override void OnInitialized()
    {
        CurrentEditContext = new EditContext(Form);

        InitializeFormInstance();

        base.OnInitialized();
    }

    private async Task OnNext()
    {
        var modifiedForm = CurrentEditContext.Model as AboutYou ?? new();
        var cachedForm = RetrieveFormFromCache();

        bool lastPage = false;
        switch (PageIndex)
        {
            case 0:
                if (!ValidateAndAssignFormProperty(modifiedForm, cachedForm, nameof(Form.Name)))
                {
                    return;
                }

                break;
            case 1:
                if (!ValidateAndAssignFormProperty(modifiedForm.Address, cachedForm, nameof(Form.Address)))
                {
                    return;
                }
                break;
            case 2:
                if (!ValidateAndAssignFormProperty(modifiedForm, cachedForm, nameof(Form.Telephone)))
                {
                    return;
                }
                break;
            case 3:
                if (!ValidateAndAssignFormProperty(modifiedForm, cachedForm, nameof(Form.Email)))
                {
                    return;
                }
                lastPage = true;
                break;
            default:
                throw new InvalidOperationException(Resource.InvalidPageIndexMessage);
        }

        WriteFormToCache(cachedForm);

        if (lastPage)
        {
            await SaveFormToDatabase(cachedForm);

            NavigationManager.NavigateTo(cachedForm.FormMetadata.ReturnUrl);
        }
        else
        {
            PageIndex++;
            NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
        }
    }
}
