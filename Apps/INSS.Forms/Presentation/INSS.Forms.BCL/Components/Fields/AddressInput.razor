@inherits InssComponentBase

<fieldset class="govuk-fieldset" id="@GenerateElementId()">
    <FieldSetHeadingText Name="fieldset-address-heading">
        @Text
    </FieldSetHeadingText>

    <ValidatedInput text="Address line 1" Name="@($"{Name}.{nameof(Value.Address1)}")" SmallText="true" Value="@Value.Address1" ValidateFor="() => Value.Address1" />

    <ValidatedInput text="Address line 2" Name="@($"{Name}.{nameof(Value.Address2)}")" SmallText="true" Value="@Value.Address2" ValidateFor="() => Value.Address2" />

    <ValidatedInput text="Town" Name="@($"{Name}.{nameof(Value.Town)}")" SmallText="true" Value="@Value.Town" ValidateFor="() => Value.Town" />

    <ValidatedInput text="Postcode" Name="@($"{Name}.{nameof(Value.Postcode)}")" SmallText="true" Value="@Value.Postcode" ValidateFor="() => Value.Postcode" />

</fieldset>


@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public Address Value { get; set; } = new Address();
}

