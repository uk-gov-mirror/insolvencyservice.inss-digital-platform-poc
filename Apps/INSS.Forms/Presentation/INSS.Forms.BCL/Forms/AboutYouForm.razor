@page "/about-you-old"
@inherits BaseFormPageModel<AboutYou>



<PageTitle>About You</PageTitle>

<HeadingText Name="heading-about-you">About You</HeadingText>

<form method="post" action="/about-you/submit">
    <AntiforgeryToken />
    
    @if(PageIndex == 0)
    {
        <TextInput Text="@Questions.WhatIsYour(Labels.Name)" Name="@nameof(@Form.Name)" Value="@Form.Name" />
    }

    @if (PageIndex == 1)
    {
        <AddressInput Text="@Questions.WhatIsYour(Labels.Address)" Name="@nameof(@Form.Address)" Value="@Form.Address" />
    }

    @if (PageIndex == 2)
    {
        <TextInput Text="@Questions.WhatIsYour(Labels.Telephone)" Name="@nameof(@Form.Telephone)" Value="@Form.Telephone" />
    }

    @if (PageIndex == 3)
    {
        <TextInput Text="@Questions.WhatIsYour(Labels.Email)" Name="@nameof(@Form.Email)" Value="@Form.Email" />
    }

    <SubmitButton Name="@EntityNames.NextButton" Text="Next" />

</form>

@code {

    protected override void OnInitialized()
    {
        InitializeForm();
    }
}
