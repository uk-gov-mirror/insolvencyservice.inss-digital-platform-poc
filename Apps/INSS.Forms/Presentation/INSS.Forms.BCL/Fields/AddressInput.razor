@using INSS.Forms.Domain.Models.Composite
@inherits InssComponentBase

<fieldset class="govuk-fieldset" id="@GenerateElementId()">
    <FieldSetHeadingText Name="fieldset-address-heading">
        @Text
    </FieldSetHeadingText>

    <TextInput text="Address line 1" Name="Address.Address1" SmallText="true" Value="@Value.Address1" />

    <TextInput text="Address line 2" Name="Address.Address2" SmallText="true" Value="@Value.Address2" />

    <TextInput text="Town" Name="Address.Town" SmallText="true" Value="@Value.Town" />

    <TextInput text="Postcode" Name="Address.Postcode" SmallText="true" Value="@Value.Postcode" />

</fieldset>


@code {
    [Parameter]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public Address Value { get; set; } = new Address();

}

