<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>

    <!--
    Inspect this path to view the c# files generated from your Razor components.
    This can be usefiul for debugging purposes and identifying bottlenecks.
    -->
    <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!--
    This allows you to use scoped CSS in your Blazor components.
    e.g. for GdsCurrencyInput component create a file named GdsCurrencyInput.razor.css
    -->
    <EnableDefaultScopedCssItems>true</EnableDefaultScopedCssItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.19" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\INSS.Forms.Components\INSS.Forms.Components.csproj" />
  </ItemGroup>


</Project>
